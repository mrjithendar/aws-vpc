" height="48" as="geometry"/></mxCell><mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7AA116;" edge="1" parent="c3" source="c53" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#C925D1;" edge="1" parent="c3" source="c54" target="c57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7AA116;" edge="1" parent="c3" source="c55" target="c58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;• Default SG: all rules removed&lt;br&gt;• Default NACL: adopted (drift visible)&lt;br&gt;• No auto-assigned public IPv4&lt;br&gt;• Peering CIDR overlap → plan fails&lt;br&gt;• State: S3, encrypted, native lock&lt;br&gt;• CI: fmt, validate, tflint, checkov,&lt;br&gt;&amp;nbsp;&amp;nbsp;plan → approval → apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=10;arcSize=4;" vertex="1" parent="c3"><mxGeometry x="1380" y="800" width="230" height="190" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;dev&lt;/b&gt;: 2 AZs, 1 shared NAT, no interface VPCEs &amp;nbsp;|&amp;nbsp; &lt;b&gt;prod&lt;/b&gt;: 3 AZs, NAT per AZ, EKS interface VPCEs, 365-day flow logs" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="c3"><mxGeometry x="360" y="1025" width="990" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>