<mxfile host="drawio" agent="generated"><diagram id="vpc" name="AWS VPC - roboshop"><mxGraphModel dx="1700" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1660" height="1110" as="geometry"/></mxCell><mxCell id="c3" value="Region: us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=1;grIcon=mxgraph.aws4.group_region;strokeColor=#147EBA;fillColor=none;fontColor=#147EBA;" vertex="1" parent="c2"><mxGeometry x="20" y="40" width="1620" height="1050" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Subnet plan (/16 VPC, e.g. dev 10.0.0.0/16, prod 10.10.0.0/16)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Public&lt;/b&gt; /24 &amp;nbsp;&amp;nbsp;x.x.0-3.0 &amp;nbsp;&amp;nbsp;&amp;nbsp;251 IPs/AZ&lt;br&gt;&lt;b&gt;Data&lt;/b&gt; /24 &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x.x.10-13.0 &amp;nbsp;251 IPs/AZ&lt;br&gt;&lt;b&gt;Intra&lt;/b&gt; /24 &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x.x.20-23.0 &amp;nbsp;251 IPs/AZ&lt;br&gt;&lt;b&gt;Private&lt;/b&gt; /20 &amp;nbsp;x.x.32-95.0 &amp;nbsp;4,091 IPs/AZ&lt;br&gt;&lt;i&gt;Spare: x.x.96.0 - x.x.255.255&lt;/i&gt;&lt;br&gt;&lt;br&gt;Each tier has its own fixed range, so adding an AZ can&#x27;t collide with another tier. AZs are pinned by &lt;b&gt;AZ ID&lt;/b&gt; (use1-az1/az2/az4), not by name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=10;arcSize=4;" vertex="1" parent="c3"><mxGeometry x="20" y="50" width="320" height="230" as="geometry"/></mxCell><mxCell id="c5" value="Default VPC (peer)&lt;br&gt;172.31.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="c3"><mxGeometry x="20" y="310" width="240" height="200" as="geometry"/></mxCell><mxCell id="c6" value="Jenkins / tooling" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;whiteSpace=wrap;" vertex="1" parent="c5"><mxGeometry x="90" y="70" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="VPC peering&lt;br&gt;DNS resolution on" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle