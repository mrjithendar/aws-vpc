fillColor=#F2F6E8;fontColor=#3F6E0B;" vertex="1" parent="05-2"><mxGeometry x="90" y="40" width="300" height="160" as="geometry"/></mxCell><mxCell id="05-5" value="Load balancer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="05-4"><mxGeometry x="124" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="05-6" value="Private subnet" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#007A7C;" vertex="1" parent="05-2"><mxGeometry x="90" y="240" width="300" height="160" as="geometry"/></mxCell><mxCell id="05-7" value="Shop app" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="05-6"><mxGeometry x="124" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="05-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="05-1" target="05-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="05-9" value="route: 0.0.0.0/0 → IGW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1D8102;fontColor=#1D8102;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="05-3" target="05-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="05-10" value="forwards inside the VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="05-5" target="05-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="05-11" value="✕ no route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D13212;fontColor=#D13212;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="05-3" target="05-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="356"/></Array></mxGeometry></mxCell><mxCell id="05-12" value="&lt;b&gt;A two-way door.&lt;/b&gt;&lt;br&gt;Traffic can come in and go out through it. AWS runs it for you, it never fills up, and it costs nothing by itself." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="350" height="100" as="geometry"/></mxCell><mxCell id="05-13" value="&lt;b&gt;Only the public subnet uses it.&lt;/b&gt;&lt;br&gt;Its route table says “anything for the internet, go via the internet gateway”. That one line is what makes a subnet public." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="180" width="350" height="110" as="geometry"/></mxCell><mxCell id="05-14" value="&lt;b&gt;The private subnet has no such line.&lt;/b&gt;&lt;br&gt;Nobody on the internet can reach it directly, even if they know its address. Customers only ever talk to the load balancer." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="350" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>