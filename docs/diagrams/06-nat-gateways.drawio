fontColor=#8C4FFF;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="06-43" target="06-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="152"/><mxPoint x="895" y="152"/></Array></mxGeometry></mxCell><mxCell id="06-45" value="Shop app" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="06-42"><mxGeometry x="52" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="06-46" value="outbound only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="06-45" target="06-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="06-47" value="&lt;b&gt;Dev&lt;/b&gt; shares one NAT gateway to save about $32 a month for each extra zone. If that zone has a bad day, dev loses its way out. That is an acceptable risk for a test environment." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="560" height="70" as="geometry"/></mxCell><mxCell id="06-48" value="&lt;b&gt;Prod&lt;/b&gt; pays for one NAT gateway per zone. Each zone has its own way out, so a single zone outage can&#x27;t cut every zone off from the internet." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D8102;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="610" y="560" width="570" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>