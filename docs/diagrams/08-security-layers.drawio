ch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="08-8"><mxGeometry x="124" y="70" width="52" height="52" as="geometry"/></mxCell><mxCell id="08-10" value="&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;allows in: port 5432 from &lt;b&gt;app-sg&lt;/b&gt; only&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="08-8"><mxGeometry x="10" y="170" width="280" height="40" as="geometry"/></mxCell><mxCell id="08-11" value="&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;allows out: what the app needs&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="08-4"><mxGeometry x="10" y="170" width="280" height="40" as="geometry"/></mxCell><mxCell id="08-12" value="✓ allowed: right badge, right door" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1D8102;fontColor=#1D8102;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="08-5" target="08-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="08-13" value="✕ turned away: not from 10.10.0.0/16 or 172.31.0.0/16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D13212;fontColor=#D13212;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="08-1" target="08-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="68" y="585"/><mxPoint x="630" y="585"/><mxPoint x="630" y="456"/></Array></mxGeometry></mxCell><mxCell id="08-14" value="&lt;b&gt;Default security group: DO NOT USE&lt;/b&gt;&lt;br&gt;Every VPC comes with one. Ours has every rule removed, so anything accidentally placed in it can&#x27;t talk to anything." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF7F6;strokeColor=#D13212;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230" y="630" width="420" height="110" as="geometry"/></mxCell><mxCell id="08-15" value="&lt;b&gt;Two layers, two jobs.&lt;/b&gt;&lt;br&gt;A security group guards one resource and remembers who it let in, so replies flow back. The network ACL guards the whole subnet and checks traffic in both directions, every time." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="630" width="460" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>