<mxfile host="drawio" agent="generated"><diagram id="10-peering" name="VPC peering"><mxGraphModel dx="1200" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="590" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10-1" value="roboshop-dev VPC &amp;nbsp;·&amp;nbsp; 10.0.0.0/16" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="450" height="420" as="geometry"/></mxCell><mxCell id="10-2" value="Shop app&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;private subnet&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="10-1"><mxGeometry x="80" y="100" width="52" height="52" as="geometry"/></mxCell><mxCell id="10-3" value="Database&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;data subnet&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="10-1"><mxGeometry x="290" y="100" width="52" height="52" as="geometry"/></mxCell><mxCell id="10-4" value="&lt;b&gt;Signpost added on this side&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:11px&quot;&gt;172.31.0.0/16 → peering link&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;in the private and data route tables&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="10-1"><mxGeometry x="30" y="260" width="390" height="85" as="geometry"/></mxCell><mxCell id="10-5" value="Default VPC &amp;nbsp;·&amp;nbsp; 172.31.0.0/16" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="450" height="420" as="geometry"/></mxCell><mxCell id="10-6" value="Jenkins&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;builds and deploys the shop&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="10-5"><mxGeometry x="199" y="100" width="52" height="52" as="geometry"/></mxCell><mxCell id="10-7" value="&lt;b&gt;Return signpost on this side&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:11px&quot;&gt;10.0.0.0/16 → peering link&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;in every route table of the default VPC&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="10-5"><mxGeometry x="30" y="260" width="390" height="85" as="geometry"/></mxCell><mxCell id="10-8" value="&lt;b&gt;VPC peering&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;private bridge,&lt;br&gt;names resolve both ways&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.peering;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="574" y="210" width="56" height="56" as="geometry"/></mxCell><mxCell id="10-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.45;entryX=0;entryY=0.5;" edge="1" parent="1" source="10-1" target="10-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="10-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=11;fontStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="10-8" target="10-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="10-11" value="&lt;b&gt;Overlap check.&lt;/b&gt; If both networks used the same addresses, signposts would be ambiguous. Our Terraform compares the two ranges and stops the plan before anything is built." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="540" height="80" as="geometry"/></mxCell><mxCell id="10-12" value="&lt;b&gt;Not transitive.&lt;/b&gt; If A is peered with B, and B with C, A still can&#x27;t reach C. Past two or three networks, a Transit Gateway (a central hub) is the better tool." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="540" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>