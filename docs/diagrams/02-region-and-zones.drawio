eometry"/></mxCell><mxCell id="02-11" value="Availability Zone use1-az4" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;fontSize=13;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="02-1"><mxGeometry x="724" y="50" width="210" height="270" as="geometry"/></mxCell><mxCell id="02-12" value="Data centre(s)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.corporate_data_center;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="02-11"><mxGeometry x="79" y="55" width="52" height="52" as="geometry"/></mxCell><mxCell id="02-13" value="Prod ✓" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#1D8102;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="02-11"><mxGeometry x="10" y="165" width="190" height="80" as="geometry"/></mxCell><mxCell id="02-14" value="&lt;b&gt;Why several zones?&lt;/b&gt; Each zone is a separate group of data centres with its own power, cooling and network, kilometres from the others. If one zone fails, the copies in the other zones keep the shop open.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why IDs, not names?&lt;/b&gt; The friendly names (us-east-1a, 1b…) are shuffled differently in every AWS account. The ID use1-az1 means the same physical place for everyone, so this setup always lands where we expect." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="45" y="360" width="910" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>