y"/></mxCell><mxCell id="03-14" value="255" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#5A6573;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1031.09375" y="142" width="30" height="18" as="geometry"/></mxCell><mxCell id="03-15" value="&lt;span style=&quot;font-size:15px;color:#7AA116&quot;&gt;&lt;b&gt;Public&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;4 × /24 reserved, 3 used&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;10.10.0.0 – 10.10.2.255&lt;/b&gt;&lt;br&gt;251 usable each&lt;br&gt;&lt;br&gt;Load balancers, NAT gateways" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="235" height="150" as="geometry"/></mxCell><mxCell id="03-16" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#7AA116;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="57.8125" y="140" as="sourcePoint"/><mxPoint x="167" y="260" as="targetPoint"/><Array as="points"><mxPoint x="57.8125" y="230"/><mxPoint x="167" y="230"/></Array></mxGeometry></mxCell><mxCell id="03-17" value="&lt;span style=&quot;font-size:15px;color:#147EBA&quot;&gt;&lt;b&gt;Data&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;4 × /24 reserved, 3 used&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;10.10.10.0 – 10.10.12.255&lt;/b&gt;&lt;br&gt;251 usable each&lt;br&gt;&lt;br&gt;Databases and caches" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="305" y="260" width="235" height="150" as="geometry"/></mxCell><mxCell id="03-18" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#147EBA;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.875" y="140" as="sourcePoint"/><mxPoint x="422" y="260" as="targetPoint"/><Array as="points"><mxPoint x="96.875" y="215"/><mxPoint x="422" y="215"/></Array></mxGeometry></mxCell><mxCell id="03-19" value="&lt;span style=&quot;font-size:15px;color:#7D8998&quot;&gt;&lt;b&gt;Intra&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;4 × /24 reserved, 3 used&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;10.10.20.0 – 10.10.22.255&lt;/b&gt;&lt;br&gt;251 usable each&lt;br&gt;&lt;br&gt;Kubernetes control-plane links" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="235" height="150" as="geometry"/></mxCell><mxCell id="03-20" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#7D8998;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.9375" y="140" as="sourcePoint"/><mxPoint x="677" y="260" as="targetPoint"/><Array as="points"><mxPoint x="135.9375" y="200"/><mxPoint x="677" y="200"/></Array></mxGeometry></mxCell><mxCell id="03-21" value="&lt;span style=&quot;font-size:15px;color:#00A4A6&quot;&gt;&lt;b&gt;Private&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6573&quot;&gt;4 × /20 reserved, 3 used&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;10.10.32.0 – 10.10.79.255&lt;/b&gt;&lt;br&gt;4,091 usable each&lt;br&gt;&lt;br&gt;Apps, Kubernetes nodes and pods" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A4A6;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="815" y="260" width="235" height="150" as="geometry"/></mxCell><mxCell id="03-22" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#00A4A6;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300.0" y="140" as="sourcePoint"/><mxPoint x="932" y="260" as="targetPoint"/><Array as="points"><mxPoint x="300.0" y="185"/><mxPoint x="932" y="185"/></Array></mxGeometry></mxCell><mxCell id="03-23" value="&lt;b&gt;Why 251 and not 256?&lt;/b&gt; AWS keeps 5 addresses in every subnet for itself: the network address, the router, the DNS server, one held for future use, and the broadcast address. Each tier also has its own fixed range, so adding a fourth zone later can never collide with another tier." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#AAB7B8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>